{
  "protocolVersion": "2.0",
  "transport": "WSS",
  "storage": "SQLITE_SINGLE_DISPATCHER",
  "heartbeatSeconds": 15,
  "leaseSeconds": 120,
  "offerAckSeconds": 10,
  "stopSafetySeconds": 5,
  "sitePollSeconds": 5,
  "siteReconnectBackoffSeconds": [1, 2, 5, 10, 30],
  "queueDelaySeconds": 600,
  "defaultSiteWeight": 1,
  "siteWeightRange": [1, 100],
  "scheduler": "SMOOTH_WEIGHTED_ROUND_ROBIN_ELIGIBLE_SITES",
  "cpuThresholdPercent": 80,
  "memoryThresholdPercent": 80,
  "diskThresholdPercent": 80,
  "resourceAdmissionStableSeconds": 15,
  "initialMaxParallel": 1,
  "transferRetriesAfterFirstAttempt": 3,
  "transferRetryBackoffSeconds": [5, 15, 45],
  "executorAttempts": 3,
  "publicationVerificationRetries": 3,
  "initialStallWarningSeconds": 600,
  "historyDays": 30,
  "auditLogDays": 30,
  "deduplicationRetention": "COMPACT_TOMBSTONES_NO_AUTOMATIC_EXPIRY",
  "orphanWorkFileRetentionHours": 24,
  "backupIntervalHours": 24,
  "backupCopies": 7,
  "maxMetadataBytes": 8388608,
  "maxManifestFiles": 10000,
  "transferGrantPageSize": 256,
  "maxUrlBytes": 16384,
  "containerMemoryTargetMiB": 256
}
